+"""Offline PERF01 baseline/candidate comparison. Never contacts a real service."""
+import argparse
+import ast
+import asyncio
+import hashlib
+import inspect
+import importlib.metadata
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import random
+import resource
+import sqlite3
+import statistics
+import subprocess
+import sys
