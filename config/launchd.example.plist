<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.wx-clawbot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/absolute/path/to/private/state/releases/VERSION-DIGEST/.venv/bin/python</string>
    <string>-I</string><string>-m</string><string>wx_clawbot.managed</string>
    <string>--release-manifest</string><string>/absolute/path/to/private/state/releases/VERSION-DIGEST/release.json</string>
    <string>--config</string><string>/absolute/path/to/private/config.json</string>
    <string>--state-dir</string><string>/absolute/path/to/private/wx-clawbot</string>
  </array>
  <key>WorkingDirectory</key><string>/absolute/path/to/private/state/releases/VERSION-DIGEST</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>120</integer>
  <key>Umask</key><integer>63</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/dev/null</string>
</dict>
</plist>
