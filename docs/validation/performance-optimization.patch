+                    'questions':[{'id':'choice','question':'synthetic choice','options':[{'label':'A'},{'label':'B'}]}]},identity)
+                await until(answer_ready,jobs)
+                record=next(r for r in engine.brokers['thread-one'].records.values() if r.state=='pending')
